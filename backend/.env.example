MODE=dev
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# One model key for OpenAI or an OpenAI-compatible endpoint.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-5-nano
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# Set true only for explicit offline testing; no real model calls will be made.
USE_FAKE_MODEL=false

# Optional LangSmith tracing (its key is separate from the model key).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hercfit-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local PostgreSQL. Docker Compose overrides host/port inside the backend container.
DATABASE_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hercfit
POSTGRES_PASSWORD=hercfit_secret
POSTGRES_DB=hercfit_db
POSTGRES_APPLICATION_NAME=hercfit-backend
POSTGRES_MIN_CONNECTIONS_PER_POOL=1
POSTGRES_MAX_CONNECTIONS_PER_POOL=10
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_TIMEOUT=30

PGVECTOR_ENABLED=true
# Optional: endpoint must support embeddings with MODEL_API_KEY.
# Dimensions must match the model output; this value does not resize embeddings.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

AUTH_SECRET=
JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8501"]
