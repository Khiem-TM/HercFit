# Cấu hình backend cho máy phát triển. Chép thành backend/.env (dev_up.sh tự chép khi chưa có) rồi điền các giá trị
# bí mật. Không commit backend/.env. Service agentic đọc cả file này và backend/agentic/.env.

MODE=dev
LOG_LEVEL=INFO

# Database dev (container hercfit-postgres). POSTGRES_PORT là cổng mở ra máy host.
POSTGRES_USER=hercfit
POSTGRES_PASSWORD=hercfit_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=hercfit_db

# Bắt buộc. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Bắt buộc, dùng chung với agentic: agent ký yêu cầu xin token uỷ quyền và gọi endpoint nội bộ. Tạo như trên.
AGENT_SERVICE_SECRET=
AGENT_DELEGATION_REQUIRED=true

# Origin của frontend: POST /api/auth/refresh chỉ nhận Origin nằm trong danh sách này.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Đăng nhập Google (OAuth client loại Web application; redirect http://localhost:5173/auth/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Health (tuỳ chọn). Mã hoá token OAuth khi lưu. Tạo:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Ký kết quả tra cứu đã kiểm chứng (dùng chung với agentic). Tạo như JWT_SECRET_KEY.
RESEARCH_ATTESTATION_SECRET=

# Lưu ảnh (tuỳ chọn).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Role database tối thiểu của agentic và kg-worker (backend/scripts/db_roles.sql). Để trống thì docker-compose dùng
# giá trị dev mặc định (hercfit_agent_dev, hercfit_kg_dev).
# AGENT_DB_PASSWORD=
# KG_DB_PASSWORD=
