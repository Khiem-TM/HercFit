# =============================================================================
# HercFit Agentic Service Environment Configuration (.env.example)
# Copy this file to .env: cp .env.example .env
# =============================================================================

# --- Runtime & Server ---
MODE=dev
AGENT_HOST=0.0.0.0
AGENT_PORT=8081
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_TIMEOUT=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# --- Security ---
AUTH_SECRET=
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256

# --- Internal CRUD Backend Connection ---
BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT_SECONDS=15.0
BACKEND_MAX_RETRIES=3

# --- LLM Providers & Model Settings ---
USE_FAKE_MODEL=true
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5-nano
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=30.0
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Embeddings & Long-Term Memory (RAG / pgvector) ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
PGVECTOR_ENABLED=true
SHORT_TERM_MAX_MESSAGES=20

# --- Checkpoints & Persistence (memory | postgres | redis) ---
CHECKPOINT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=hercfit
POSTGRES_PASSWORD=hercfit_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hercfit_db
POSTGRES_APPLICATION_NAME=hercfit-agentic

# --- Observability & Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hercfit-agentic
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

