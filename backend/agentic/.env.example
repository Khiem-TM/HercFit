# Bắt buộc: dev (máy phát triển) hoặc prod. Thiếu thì agentic không khởi động.
MODE=dev
BACKEND_BASE_URL=http://localhost:8080
AGENT_DATABASE_URL=postgresql://hercfit:hercfit_secret@localhost:5433/hercfit_agentic
DEFAULT_PROVIDER=openrouter
# Shared key belongs in backend/.env; an explicit environment value takes precedence.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=deepseek/deepseek-v4-flash
# For other compatible providers: DEFAULT_PROVIDER=openai_compatible,
# MODEL_BASE_URL=..., MODEL_API_KEY=...
# Each role inherits DEFAULT_MODEL when omitted.
# DECISION_MODEL=
# RESPONSE_MODEL=
# TOOL_MODEL=
# RESEARCH_MODEL=
# Per-agent models (agent names in core/roster.py); absent agents use their role model.
# "context" writes the context-graph Cypher; its self-repair after a rejection always uses the role model.
# Measured mapping (multi-agent eval 2026-11-07, kg_eval context --generate 2026-11-10):
AGENT_MODELS={"nutrition":"google/gemma-4-26b-a4b-it","memory":"google/gemma-4-26b-a4b-it","body_health":"google/gemma-4-31b-it","clarify":"google/gemma-4-31b-it","context":"google/gemma-4-31b-it"}
TAVILY_API_KEY=
MAX_TOOL_CALLS=12
RUN_TIMEOUT_SECONDS=180
PLAN_RUN_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=2
MODEL_STREAM_USAGE=true
# Per-call model timeouts: routing/clarify return small JSON; tool calls write whole payloads.
# ROUTING_TIMEOUT_SECONDS=30
# TOOL_TIMEOUT_SECONDS=60
# RESPONSE_TIMEOUT_SECONDS=90
# RESEARCH_TIMEOUT_SECONDS=60
CONFIRMATION_TTL_SECONDS=1800

# The knowledge graph is always part of the agent context (Neo4j + kg-worker run with
# the stack). An unreachable Neo4j only degrades a turn to the backend tools.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hercfit-graph-dev
NEO4J_DATABASE=neo4j
# Required when backend and agent use separate databases. Omit for shared DB.
KG_BACKEND_DATABASE_URL=postgresql://hercfit:hercfit_secret@localhost:5432/hercfit_db
KG_RETRIEVAL_TIMEOUT_MS=150
KG_FACT_LIMIT=12
KG_EPISODE_LIMIT=3
KG_CONTEXT_TOKEN_BUDGET=1500
KG_BUSINESS_RETENTION_DAYS=90
KG_MEMORY_RETENTION_DAYS=30
KG_WORKER_POLL_SECONDS=1
KG_WORKER_BATCH_SIZE=100
KG_RECONCILE_SECONDS=5

# --- Observability & Tracing (Langfuse) ---
# Tắt mặc định; bật khi đã có cặp key của project Langfuse.
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev
# LANGFUSE_RELEASE=
# redacted (mặc định) hoặc metadata_only (không gửi prompt/câu trả lời).
# LANGFUSE_CAPTURE_MODE=redacted
# LANGFUSE_SAMPLE_RATE=1.0
# Tuỳ chọn: khi để trống được suy ra từ LANGFUSE_SECRET_KEY bằng HMAC.
# LANGFUSE_PSEUDONYM_SECRET=
# LANGFUSE_PROPAGATION_SECRET=
# Giá model đã kiểm chứng (USD/1M token) cho đo chi phí cục bộ.
# Estimates only; actual OpenRouter usage.cost is authoritative.
# MODEL_PRICES={"openrouter/deepseek/deepseek-v4-flash":{"input_per_million":0.09,"output_per_million":0.18}}

# Lớp hội thoại giọng nói (LiveKit Cloud). Để trống thì nút micro báo chưa bật; worker: backend/voice/worker.py.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Model nghe/đọc qua LiveKit Inference, voice id của nhà cung cấp TTS, và model viết lại câu trả lời thành lời nói (tuỳ chọn).
# VOICE_STT=deepgram/nova-3
# VOICE_TTS=cartesia/sonic-3
# VOICE_TTS_VOICE=
# VOICE_REWRITE_MODEL=google/gemini-3.5-flash-lite
