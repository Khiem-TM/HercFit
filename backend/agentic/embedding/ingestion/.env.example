# Settings precedence: backend/.env < backend/agentic/.env < backend/agentic/embedding/ingestion/.env < process env.
# FPT_API_KEY can be inherited from backend/agentic/.env. Do not put a real key here.
# FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024
# Change together with a re-chunk; set the same value in backend/.env after `activate`.
EMBEDDING_REVISION=e5-ctx-v2
KNOWLEDGE_EMBEDDING_BATCH_SIZE=8
KNOWLEDGE_EMBEDDING_RETRIES=3
KNOWLEDGE_REQUEST_INTERVAL=0.2
# Defaults: backend/agentic/embedding/ingestion/data/.cache/e5-tokenizer.json and data/input
# KNOWLEDGE_TOKENIZER_PATH=/absolute/path/to/e5-tokenizer.json
# KNOWLEDGE_INGEST_ROOT=/absolute/path/to/input
